@startuml
title Aset-Pinjam - Class Diagram (berdasarkan source code)

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

package "id.ac.upb.asetpinjam.model" {
  abstract class Aset {
    - kode: String
    - nama: String
    - status: StatusAset = TERSEDIA
    - kondisi: Kondisi = BAIK
    + Aset(kode: String, nama: String)
    + getKode(): String
    + getNama(): String
    + getStatus(): StatusAset
    + getKondisi(): Kondisi
    + setNama(nama: String): void
    + setStatus(status: StatusAset): void
    + setKondisi(kondisi: Kondisi): void
    + bisaDipinjam(): boolean
    + getJenis(): JenisAset
    {abstract} + hitungDenda(hariTerlambat: int): long
  }

  class Ruang {
    - kapasitas: int
    + Ruang(kode: String, nama: String, kapasitas: int)
    + getKapasitas(): int
    + getJenis(): JenisAset
    + hitungDenda(hariTerlambat: int): long
  }

  class Laptop {
    - spesifikasi: String
    - nomorInventaris: String
    + Laptop(kode: String, nama: String, spesifikasi: String, nomorInventaris: String)
    + getSpesifikasi(): String
    + getNomorInventaris(): String
    + getJenis(): JenisAset
    + hitungDenda(hariTerlambat: int): long
  }

  class AlatLab {
    - laboratorium: String
    - tingkatRisiko: TingkatRisiko
    + AlatLab(kode: String, nama: String, laboratorium: String, tingkatRisiko: TingkatRisiko)
    + getLaboratorium(): String
    + getTingkatRisiko(): TingkatRisiko
    + getJenis(): JenisAset
    + hitungDenda(hariTerlambat: int): long
  }

  class Peminjaman {
    - id: String
    - peminjam: Peminjam
    - aset: Aset
    - mulai: LocalDateTime
    - selesai: LocalDateTime
    - status: StatusPeminjaman = DIAJUKAN
    + Peminjaman(id: String, peminjam: Peminjam, aset: Aset, mulai: LocalDateTime, selesai: LocalDateTime)
    + getId(): String
    + getPeminjam(): Peminjam
    + getAset(): Aset
    + getMulai(): LocalDateTime
    + getSelesai(): LocalDateTime
    + getStatus(): StatusPeminjaman
    + setStatusDariPenyimpanan(status: StatusPeminjaman): void
    + ubahStatus(baru: StatusPeminjaman): void
  }

  class Peminjam <<record>> {
    + id: String
    + nama: String
    + Peminjam(id: String, nama: String)
    + id(): String
    + nama(): String
  }

  enum StatusAset {
    TERSEDIA
    DIPINJAM
    RUSAK
  }
  enum Kondisi {
    BAIK
    RUSAK_RINGAN
    RUSAK_BERAT
  }
  enum JenisAset {
    RUANG
    LAPTOP
    ALAT_LAB
  }
  enum TingkatRisiko {
    RENDAH
    SEDANG
    TINGGI
  }
  enum StatusPeminjaman {
    DIAJUKAN
    DISETUJUI
    DITOLAK
    DIBATALKAN
    DIPINJAM
    TERLAMBAT
    DIKEMBALIKAN
  }
}

package "id.ac.upb.asetpinjam.kontrak" {
  interface DapatDipinjam {
    + bisaDipinjam(): boolean
  }
  interface AturanDenda {
    + hitung(aset: Aset, hariTerlambat: int): long
  }
}

package "id.ac.upb.asetpinjam.denda" {
  class DendaFlat {
    + hitung(aset: Aset, hariTerlambat: int): long
  }
  class DendaProgresif {
    + hitung(aset: Aset, hariTerlambat: int): long
  }
  class LayananDenda {
    + LayananDenda(aturan: AturanDenda)
    + hitung(aset: Aset, hariTerlambat: int): long
  }
}

package "id.ac.upb.asetpinjam.jadwal" {
  class JadwalPeminjaman {
    - daftar: List<Peminjaman>
    - kuotaLaptop: int
    + JadwalPeminjaman(kuotaLaptop: int)
    # kuotaLaptop(): int
    # daftarMutable(): List<Peminjaman>
    + tambah(p: Peminjaman): void
    + bentrok(baru: Peminjaman): boolean
    + semuaUrutMulai(): List<Peminjaman>
    + perAset(): Map<String, List<Peminjaman>>
    + hapus(id: String): boolean
    + ajukan(baru: Peminjaman): void
  }
}

package "id.ac.upb.asetpinjam.katalog" {
  class KatalogAset {
    - daftar: List<Aset>
    + tambah(aset: Aset): void
    + semua(): List<Aset>
    + cari(kata: String): List<Aset>
    + cari(kata: String, jenis: JenisAset): List<Aset>
  }
}

package "id.ac.upb.asetpinjam.dao" {
  interface AsetDAO {
    + simpan(aset: Aset): void
    + cariByKode(kode: String): Optional<Aset>
    + semua(): List<Aset>
    + perbarui(aset: Aset): void
    + hapus(kode: String): boolean
  }
  interface PeminjamanDAO {
    + simpan(peminjaman: Peminjaman): void
    + cariById(id: String): Optional<Peminjaman>
    + perbaruiStatus(id: String, status: StatusPeminjaman): boolean
  }
  class JdbcAsetDAO {
    - sumberKoneksi: Supplier<Connection>
    + JdbcAsetDAO(sumberKoneksi: Supplier<Connection>)
  }
  class JdbcPeminjamanDAO {
    - sumberKoneksi: Supplier<Connection>
    - asetDao: AsetDAO
    + JdbcPeminjamanDAO(sumberKoneksi: Supplier<Connection>, asetDao: AsetDAO)
  }
  class Koneksi {
    - Koneksi()
    {static} + baru(): Connection
  }
}

package "id.ac.upb.asetpinjam.factory" {
  class AsetFactory {
    - AsetFactory()
    {static} + buat(jenis: JenisAset, kode: String, nama: String, atribut: String...): Aset
  }
}

package "id.ac.upb.asetpinjam.config" {
  class Varian {
    - {static} aktif: Varian
    + nim: String
    + nama: String
    + dendaPerHari: int
    + batasDurasiJam: int
    + kuotaLaptop: int
    - Varian(nim: String, nama: String)
    {static} + dariNim(nim: String, nama: String): Varian
    {static} + aktif(): Varian
  }
}

package "id.ac.upb.asetpinjam.exception" {
  class AsetPinjamException
  class PeminjamanBentrokException
  class KuotaHabisException
  class StatusTidakSahException
  class DataAksesException
}

' Generalization dan realization
Aset <|-- Ruang
Aset <|-- Laptop
Aset <|-- AlatLab
DapatDipinjam <|.. Aset
AturanDenda <|.. DendaFlat
AturanDenda <|.. DendaProgresif
AsetDAO <|.. JdbcAsetDAO
PeminjamanDAO <|.. JdbcPeminjamanDAO

' Association dan multiplicity sesuai field/collection yang terlihat pada source
Peminjaman "0..*" --> "1" Peminjam : peminjam
Peminjaman "0..*" --> "1" Aset : aset
JadwalPeminjaman "1" --> "0..*" Peminjaman : daftar
KatalogAset "1" --> "0..*" Aset : daftar
JdbcPeminjamanDAO "0..*" --> "1" AsetDAO : asetDao
LayananDenda --> AturanDenda : aturan
JdbcAsetDAO ..> Koneksi : koneksi dipasok via Supplier
JdbcPeminjamanDAO ..> Koneksi : koneksi dipasok via Supplier
DendaFlat ..> Aset
DendaProgresif ..> Aset
Aset ..> StatusAset
Aset ..> Kondisi
Aset ..> JenisAset
AlatLab ..> TingkatRisiko
Peminjaman ..> StatusPeminjaman
AsetFactory ..> JenisAset
AsetFactory ..> Aset
Varian ..> Aset

AsetPinjamException <|-- PeminjamanBentrokException
AsetPinjamException <|-- KuotaHabisException
AsetPinjamException <|-- StatusTidakSahException
AsetPinjamException <|-- DataAksesException

note bottom of JadwalPeminjaman
  bentrok(), semuaUrutMulai(), perAset(), hapus(),
  dan ajukan() masih TODO pada source yang diberikan.
end note

note bottom of LayananDenda
  Konstruktor dan hitung() masih TODO pada source yang diberikan.
end note
@enduml
